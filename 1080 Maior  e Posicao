Objetivo    : Ler 100 valores inteiros. Apresentar o maior valor lido e a posição dentre os 100 valores lidos.
Dificuldade : 
Uso de IA   : indicar melhorias 
-------------------------------------------------------------------------- */

#include <stdio.h>

int main (){
    int n, maior, posicao;

    for (int i=1; i<=100; i++){
        scanf("%d", &n);

        if(i == 1 || n>maior){
            maior = n;
            posicao = i;
        }
    }
    printf("%d\n", maior);
    printf("%d\n", posicao);

    return 0;
}
